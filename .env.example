# Copy to .env and fill in. Never commit .env.

# --- Contracts (Sepolia) ---
SEPOLIA_RPC_URL=              # a Sepolia RPC endpoint; see ANON_RPC_URL below for the CROPS/Anon-RPC path
DEPLOYER_PRIVATE_KEY=         # 0x-prefixed hex private key of the contract deployer wallet — testnet only, never reuse
MAINTAINER_ADDRESS=           # address that will hold KillSwitch's maintainer role (can be the deployer for the demo)
KILLSWITCH_ADDRESS=           # KillSwitch's deployed address, once deployed — read by status-page/

# --- ENS (Sepolia, ENSv2) ---
ENS_REGISTRY_ADDRESS=         # shankh.eth's PermissionedRegistry -- see docs/evidence.md. Displayed by status-page/lib/registry.ts
PYPI_REGISTRY_ADDRESS=        # pypi.shankh.eth's registry -- status-page reads isEmancipated() on it live, every request
ANON_RPC_URL=                 # Anon-RPC endpoint for private ENS reads, if/when confirmed to support Sepolia (see docs/plan.md spike 2)
OPERATOR_PRIVATE_KEY=         # used by scripts/ens/register-tree-*.sh -- same wallet as DEPLOYER_PRIVATE_KEY works fine
PACKAGE_RESOLVER_ADDRESS=     # the real tree's shankh-demo.pypi.shankh.eth resolver -- see docs/evidence.md. Read by shankh/shankh/ens/ and status-page/lib/ens.ts
PACKAGE_DNS_ENCODED_NAME=     # DNS-wire encoding of shankh-demo.pypi.shankh.eth -- see docs/evidence.md for the exact bytes

# --- Arkiv (testnet) ---
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095
ARKIV_ACCESS_KEY=             # from https://hub.arkiv.network/access-keys
ARKIV_WALLET_PRIVATE_KEY=     # wallet that owns the shankh.report / shankh.request entities — testnet only

# --- AWS (sandbox account, never production) ---
AWS_PROFILE=shankh-sandbox     # the disposable account the demo's "stolen" key belongs to
AWS_AUDIT_PROFILE=shankh-audit # separate read-only profile for CloudTrail LookupEvents, per plan-2.md Design > Kill and clean

# --- Status page (status-page/, deployed via Vercel) ---
# Reads KILLSWITCH_ADDRESS, PACKAGE_RESOLVER_ADDRESS, PACKAGE_DNS_ENCODED_NAME, SEPOLIA_RPC_URL
# and ARKIV_RPC_URL/ARKIV_ACCESS_KEY above server-side (it's a read-only page, no private key
# needed) — set the same values again as Vercel project env vars, they don't need the
# NEXT_PUBLIC_ prefix since nothing is read client-side.
NEXT_PUBLIC_ENS_REGISTRY_ADDRESS=   # mirrors ENS_REGISTRY_ADDRESS, if a client-side ENS read is ever added
